{
   "manifest_version": 3,
   "name": "Cookie Blocker",
   "version": "0.1",
   "description": "Refuse automatiquement les cookies non nécessaires.",
   "icons": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
   },

   "action": {
      "default_icon": {
         "16": "images/icon-16.png",
         "32": "images/icon-32.png",
         "48": "images/icon-48.png",
         "128": "images/icon-128.png"
      }
   },
   "content_scripts": [
      {
         "matches": ["<all_urls>"],
         "js": ["content.js"]
      }
   ]
}